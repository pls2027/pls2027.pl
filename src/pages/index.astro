---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Polska Loteria Sejmowa 2027 | Prawdziwa Demokracja">
  <!-- NAV -->
  <nav class="bg-white border-b sticky top-0 z-50">
    <div class="max-w-7xl mx-auto px-6 py-4 flex justify-between items-center">
      <a href="#" class="flex items-center gap-3">
        <div class="w-10 h-10 bg-[#c00000] rounded-full flex items-center justify-center">
          <span class="text-white font-bold text-xl">PLS</span>
        </div>
        <span class="font-bold text-2xl tracking-tight">Polska Loteria Sejmowa</span>
      </a>
      
      <div class="hidden md:flex gap-8 text-sm font-medium">
        <a href="#onas" class="hover:text-[#c00000] transition">O nas</a>
        <a href="#dlaczego" class="hover:text-[#c00000] transition">Dlaczego?</a>
        <a href="#czego" class="hover:text-[#c00000] transition">Czego chcemy?</a>
        <a href="#jak" class="hover:text-[#c00000] transition">Jak?</a>
        <a href="#kandydaci" class="hover:text-[#c00000] transition">Rejestr Kandydatów</a>
        <a href="#losowanie" class="hover:text-[#c00000] transition">Losowanie</a>
        <a href="#wspolpraca" class="hover:text-[#c00000] transition">Współpraca</a>
        <a href="#kontakt" class="hover:text-[#c00000] transition">Kontakt</a>
      </div>

      <div class="flex items-center gap-4">
        <a href="#losowanie" class="btn text-sm py-2 px-6">Dołącz do losowania</a>
        <button onclick="showAIAssistant()" class="btn-secondary text-sm py-2 px-5 flex items-center gap-2">
          🤖 Asystent AI
        </button>
      </div>
    </div>
  </nav>

  <!-- HERO -->
  <section class="hero-bg min-h-[100dvh] flex items-center text-white relative">
    <div class="max-w-5xl mx-auto px-6 text-center pt-20">
      <div class="inline-block bg-white/10 backdrop-blur px-4 py-1 rounded-full text-sm mb-6">
        INICJATYWA OBYWATELSKA 2027
      </div>
      
      <h1 class="text-6xl md:text-7xl font-bold tracking-tighter mb-6 leading-none">
        WEŹ LOS<br>W SWOJE RĘCE
      </h1>
      
      <p class="text-2xl md:text-3xl max-w-3xl mx-auto mb-10 text-white/90">
        Polska Loteria Sejmowa — koniec z partyjnictwem.<br>
        Czas na prawdziwą demokrację.
      </p>

      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="#losowanie" class="btn text-xl px-12 py-5">Zapisz się do losowania</a>
        <a href="#kandydaci" class="btn-secondary text-xl px-12 py-5">Zobacz kandydatów</a>
      </div>

      <div class="mt-16 text-sm opacity-75">
        Już ponad <span class="font-bold text-white">72%</span> poparcia w sondażach • Dołącz do ruchu
      </div>
    </div>

    <div class="absolute bottom-10 left-1/2 -translate-x-1/2 animate-bounce">
      <a href="#onas">↓</a>
    </div>
  </section>

  <!-- STATS / POLL -->
  <section class="bg-white py-8 border-b">
    <div class="max-w-5xl mx-auto px-6">
      <div class="flex flex-wrap justify-center gap-x-12 gap-y-4 text-center">
        <div>
          <div class="text-4xl font-bold text-[#c00000]">72,4%</div>
          <div class="text-sm text-gray-600">Poparcia w sondażu</div>
        </div>
        <div>
          <div class="text-4xl font-bold text-[#c00000]">307</div>
          <div class="text-sm text-gray-600">Zadaniowych posłów</div>
        </div>
        <div>
          <div class="text-4xl font-bold text-[#c00000]">3 mln+</div>
          <div class="text-sm text-gray-600">Potrzebnych podpisów</div>
        </div>
      </div>
    </div>
  </section>

  <!-- O NAS -->
  <section id="onas" class="max-w-5xl mx-auto px-6 py-20">
    <h2 class="section-title">O nas</h2>
    <div class="prose max-w-none text-lg">
      <p>Polska Loteria Sejmowa to inicjatywa skupiająca osoby, grupy i organizacje, które naprawdę chcą <strong>prawdziwej demokracji obywatelskiej</strong> w Polsce.</p>
      <p>Naszym celem jest wprowadzenie zmiany ordynacji wyborczej, która przywróci władzę suwerenowi — Narodowi.</p>
      <p>Wierzymy, że każdy obywatel może mieć realny wpływ na funkcjonowanie państwa. Inicjatywa ma charakter otwarty i zapraszamy osoby o różnych poglądach.</p>
    </div>
  </section>

  <!-- DLACZEGO -->
  <section id="dlaczego" class="bg-white py-16">
    <div class="max-w-5xl mx-auto px-6">
      <h2 class="section-title">Dlaczego chcemy zmian?</h2>
      <div class="grid md:grid-cols-2 gap-8 text-lg">
        <div>
          <p>Uważamy, że panujący w naszym kraju system partiokracji jest sprzeczny z konstytucyjnym zapisem:</p>
          <blockquote class="border-l-4 border-[#c00000] pl-6 italic my-6 text-xl">
            „Władza zwierzchnia w Rzeczypospolitej Polskiej należy do Narodu.”
          </blockquote>
        </div>
        <div class="space-y-4">
          <p>Coraz więcej osób czuje brak wpływu na decyzje publiczne.</p>
          <p>Chcemy rozpocząć szeroko zakrojoną akcję społeczną i skończyć z podziałami partyjnymi.</p>
          <p>Wierzymy, że różnorodność doświadczeń obywateli jest naszą największą wartością.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CZEGO CHCEMY -->
  <section id="czego" class="max-w-5xl mx-auto px-6 py-20">
    <h2 class="section-title">Czego chcemy?</h2>
    <p class="text-xl mb-8">Naszym celem jest przedstawienie nowego projektu ordynacji oraz doprowadzenie do jej ustanowienia.</p>
    
    <div class="grid md:grid-cols-2 gap-6">
      <div class="card">
        <h3 class="font-bold text-xl mb-3">Główne postulaty</h3>
        <ul class="space-y-2 text-lg">
          <li>✓ Większy udział obywateli w wyborach</li>
          <li>✓ Większa przejrzystość życia publicznego</li>
          <li>✓ Odpowiedzialność osób pełniących funkcje publiczne</li>
          <li>✓ Silniejszy dialog społeczny</li>
          <li>✓ Edukacja obywatelska</li>
        </ul>
      </div>
      <div class="card">
        <h3 class="font-bold text-xl mb-3">Pytania, na które odpowiadamy TAK</h3>
        <p class="text-gray-700">Chcesz głosować na konkretnego człowieka, a nie na numer na liście partyjnej? Chcesz, aby poseł odpowiadał przed wyborcami, a nie przed szefem partii? Chcesz więcej lokalnych społeczników i ekspertów w Sejmie?</p>
        <p class="mt-4 font-semibold">Jeśli choć na jedno pytanie odpowiedziałeś twierdząco — dołącz do nas!</p>
      </div>
    </div>
  </section>

  <!-- JAK -->
  <section id="jak" class="bg-white py-16">
    <div class="max-w-5xl mx-auto px-6">
      <h2 class="section-title">Jak chcemy to osiągnąć?</h2>
      
      <div class="prose max-w-none text-lg">
        <p>Chętni na bycie <strong>zadaniowym posłem</strong> poszukiwani!</p>
        <p>Posyłamy większość konstytucyjną (307 posłów) z wyboru losu celem wprowadzenia konkretnych zmian w ordynacji wyborczej. Zadanie nie jest na całą kadencję — wystarczy jedno posiedzenie, po którym Sejm się samorozwiązuje i odbywają się <strong>pierwsze prawdziwie wolne wybory</strong>.</p>
        
        <div class="bg-gray-50 p-8 rounded-2xl my-8">
          <h4 class="font-bold mb-4">Mechanizm:</h4>
          <ol class="list-decimal pl-6 space-y-2">
            <li>Chętni do kandydowania trafiają do puli losowania w swoich okręgach.</li>
            <li>Losowanie odbywa się na żywo z transmisją online.</li>
            <li>Obstawiamy wszystkie listy i zdobywamy większość konstytucyjną.</li>
            <li>Po wykonaniu zadania — przyspieszone, wolne wybory.</li>
          </ol>
        </div>
      </div>
    </div>
  </section>

  <!-- REJESTR KANDYDATÓW -->
  <section id="kandydaci" class="max-w-7xl mx-auto px-6 py-20">
    <div class="flex justify-between items-end mb-8">
      <div>
        <h2 class="section-title">Rejestr Kandydatów</h2>
        <p class="text-xl">Zarejestrowani kandydaci na zadaniowych posłów według okręgów</p>
      </div>
      <a href="#losowanie" class="btn">Zgłoś się jako kandydat</a>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
      <!-- Mock candidates -->
      <div class="candidate-card">
        <div class="flex justify-between mb-4">
          <div>
            <div class="font-bold text-xl">Anna Kowalska</div>
            <div class="text-sm text-gray-500">Okręg 1 – Warszawa</div>
          </div>
          <div class="rating">★★★★★ <span class="text-gray-500 text-sm ml-1">(124)</span></div>
        </div>
        <p class="text-sm text-gray-600 mb-4">Przedsiębiorczyni, aktywistka lokalna. Chce wprowadzić transparentność w finansach publicznych.</p>
        <div class="flex gap-2">
          <button onclick="rateCandidate(0)" class="text-xs px-3 py-1 bg-gray-100 rounded">Oceń</button>
          <button class="text-xs px-3 py-1 bg-gray-100 rounded">Portfolio PDF</button>
        </div>
      </div>

      <div class="candidate-card">
        <div class="flex justify-between mb-4">
          <div>
            <div class="font-bold text-xl">Marek Nowak</div>
            <div class="text-sm text-gray-500">Okręg 5 – Kraków</div>
          </div>
          <div class="rating">★★★★☆ <span class="text-gray-500 text-sm ml-1">(89)</span></div>
        </div>
        <p class="text-sm text-gray-600 mb-4">Nauczyciel akademicki, ekspert ds. edukacji. Chce reformy systemu oświaty.</p>
        <div class="flex gap-2">
          <button onclick="rateCandidate(1)" class="text-xs px-3 py-1 bg-gray-100 rounded">Oceń</button>
          <button class="text-xs px-3 py-1 bg-gray-100 rounded">Portfolio PDF</button>
        </div>
      </div>

      <div class="candidate-card">
        <div class="flex justify-between mb-4">
          <div>
            <div class="font-bold text-xl">Ewa Zielińska</div>
            <div class="text-sm text-gray-500">Okręg 12 – Poznań</div>
          </div>
          <div class="rating">★★★★★ <span class="text-gray-500 text-sm ml-1">(156)</span></div>
        </div>
        <p class="text-sm text-gray-600 mb-4">Lekarka, działaczka społeczna. Walczy o lepszą ochronę zdrowia.</p>
        <div class="flex gap-2">
          <button onclick="rateCandidate(2)" class="text-xs px-3 py-1 bg-gray-100 rounded">Oceń</button>
          <button class="text-xs px-3 py-1 bg-gray-100 rounded">Portfolio PDF</button>
        </div>
      </div>
    </div>

    <p class="text-center mt-8 text-sm text-gray-500">Pełny rejestr z możliwością filtrowania po okręgach dostępny po zalogowaniu (wkrótce).</p>
  </section>

  <!-- ZAPIS DO LOSOWANIA -->
  <section id="losowanie" class="bg-white py-16 border-t">
    <div class="max-w-3xl mx-auto px-6">
      <h2 class="section-title text-center">Zapis do Losowania</h2>
      <p class="text-center text-xl mb-10">Chcesz zostać zadaniowym posłem? Zgłoś się do puli losowania.</p>

      <form class="card space-y-6" onsubmit="submitLotteryForm(event)">
        <div class="grid md:grid-cols-2 gap-6">
          <div>
            <label class="block text-sm font-medium mb-1">Imię i nazwisko</label>
            <input type="text" class="w-full border rounded-xl p-3" required>
          </div>
          <div>
            <label class="block text-sm font-medium mb-1">Okręg wyborczy</label>
            <select class="w-full border rounded-xl p-3" required>
              <option>Warszawa</option>
              <option>Kraków</option>
              <option>Poznań</option>
              <option>Wrocław</option>
              <option>Gdańsk</option>
              <option>Inny...</option>
            </select>
          </div>
        </div>
        
        <div>
          <label class="block text-sm font-medium mb-1">Dlaczego chcesz zostać zadaniowym posłem? (krótko)</label>
          <textarea class="w-full border rounded-xl p-3 h-24" required></textarea>
        </div>

        <div class="flex items-center gap-3">
          <input type="checkbox" required class="w-4 h-4">
          <span class="text-sm">Zgadzam się na przetwarzanie danych i udział w losowaniu na żywo.</span>
        </div>

        <button type="submit" class="btn w-full text-lg py-4">Zgłoś się do puli losowania</button>
      </form>
    </div>
  </section>

  <!-- WSPÓŁPRACA NAD DOKUMENTAMI -->
  <section id="wspolpraca" class="max-w-5xl mx-auto px-6 py-20">
    <h2 class="section-title">Współpraca nad dokumentami</h2>
    <p class="text-xl mb-8">Razem tworzymy projekt nowej ordynacji wyborczej. Proponuj zmiany, komentuj i zatwierdzaj fragmenty tekstu jednolitego.</p>

    <div class="grid lg:grid-cols-2 gap-8">
      <!-- Current text -->
      <div class="card">
        <h3 class="font-bold mb-4">Tekst jednolity (aktualny)</h3>
        <div class="prose text-sm bg-gray-50 p-6 rounded-xl max-h-80 overflow-auto">
          <p>Art. 1. Wybory do Sejmu odbywają się w drodze losowania spośród zarejestrowanych kandydatów w każdym okręgu...</p>
          <p class="mt-4">...</p>
        </div>
      </div>

      <!-- Proposals -->
      <div class="card">
        <h3 class="font-bold mb-4">Propozycje zmian od społeczności</h3>
        
        <div class="space-y-4 mb-6 max-h-64 overflow-auto pr-2">
          <div class="border-l-4 border-green-500 pl-4">
            <div class="text-sm font-medium">Jan K. • 2 dni temu</div>
            <p class="text-sm">Proponuję dodać mechanizm odwoływania posła przez wyborców w trakcie kadencji.</p>
            <div class="flex gap-2 mt-2">
              <button class="text-xs bg-green-100 px-3 py-1 rounded">Zatwierdź (47)</button>
              <button class="text-xs bg-gray-100 px-3 py-1 rounded">Skomentuj</button>
            </div>
          </div>
          
          <div class="border-l-4 border-yellow-500 pl-4">
            <div class="text-sm font-medium">Maria L. • wczoraj</div>
            <p class="text-sm">Zmiana w art. 5 – większa waga głosów z mniejszych okręgów.</p>
            <div class="flex gap-2 mt-2">
              <button class="text-xs bg-green-100 px-3 py-1 rounded">Zatwierdź (31)</button>
              <button class="text-xs bg-gray-100 px-3 py-1 rounded">Skomentuj</button>
            </div>
          </div>
        </div>

        <form onsubmit="submitProposal(event)" class="flex gap-3">
          <input type="text" placeholder="Twoja propozycja zmiany..." class="flex-1 border rounded-xl px-4 text-sm" required>
          <button type="submit" class="btn text-sm px-6">Wyślij</button>
        </form>
      </div>
    </div>
  </section>

  <!-- ZBIÓRKA PODPISÓW -->
  <section class="bg-[#c00000] text-white py-16">
    <div class="max-w-4xl mx-auto px-6 text-center">
      <h2 class="text-4xl font-bold mb-4">Zbiórka podpisów</h2>
      <p class="text-xl mb-8 opacity-90">Potrzebujemy co najmniej 3 milionów podpisów poparcia, żeby wystawić listę w każdym okręgu.</p>
      
      <div class="max-w-md mx-auto">
        <div class="bg-white/10 rounded-2xl p-8 mb-6">
          <div class="text-6xl font-bold mb-2">1 248 392</div>
          <div class="text-lg">podpisów zebranych</div>
          <div class="w-full bg-white/30 h-3 rounded mt-6">
            <div class="bg-white h-3 rounded w-[41%]"></div>
          </div>
          <div class="text-sm mt-2 opacity-75">Cel: 3 000 000</div>
        </div>

        <a href="#" class="btn bg-white text-[#c00000] hover:bg-gray-100 text-xl px-16 py-5 inline-block">Podpisz petycję online</a>
        <p class="text-sm mt-4 opacity-75">Lub pobierz formularz i zbierz podpisy wśród znajomych</p>
      </div>
    </div>
  </section>

  <!-- KONTAKT + SOCIAL -->
  <section id="kontakt" class="max-w-5xl mx-auto px-6 py-20">
    <div class="grid md:grid-cols-2 gap-12">
      <div>
        <h2 class="section-title">Kontakt</h2>
        <div class="space-y-4 text-lg">
          <p><strong>E-mail:</strong> <a href="mailto:polskaloteriasejmowa@gmail.com" class="text-[#c00000]">polskaloteriasejmowa@gmail.com</a></p>
          
          <div class="pt-4">
            <a href="https://www.facebook.com/groups/1325996715575240/" target="_blank" class="btn-secondary mr-3">Grupa Facebook</a>
            <a href="https://chat.whatsapp.com/IgShFfj5RVc4kO33CfM1So" target="_blank" class="btn-secondary">Grupa WhatsApp</a>
          </div>
        </div>
      </div>

      <div>
        <h3 class="font-bold text-xl mb-4">Śledź nas</h3>
        <div class="flex gap-4 text-3xl">
          <a href="#" class="hover:text-[#c00000] transition">📺 YouTube</a>
          <a href="#" class="hover:text-[#c00000] transition">𝕏 X / Twitter</a>
          <a href="#" class="hover:text-[#c00000] transition">🎵 TikTok</a>
        </div>
        <p class="text-sm text-gray-500 mt-4">Linki do kanałów dodamy wkrótce — śledź aktualizacje!</p>
      </div>
    </div>
  </section>

  <footer class="bg-gray-900 text-white/70 py-12 text-center text-sm">
    © 2027 Polska Loteria Sejmowa • Prawdziwa demokracja zaczyna się od Ciebie.<br>
    Strona zbudowana z Astro + Tailwind • Inicjatywa obywatelska
  </footer>

  <!-- AI Assistant Modal -->
  <div id="ai-modal" class="hidden fixed inset-0 bg-black/60 flex items-center justify-center z-[100]">
    <div class="bg-white w-full max-w-lg mx-4 rounded-3xl overflow-hidden shadow-2xl">
      <div class="bg-[#c00000] text-white px-6 py-4 flex justify-between items-center">
        <div class="font-bold flex items-center gap-2">🤖 Asystent AI — PLS 2027</div>
        <button onclick="hideAIAssistant()" class="text-2xl leading-none">×</button>
      </div>
      
      <div class="p-6 h-80 overflow-auto text-sm" id="ai-chat">
        <div class="bg-gray-100 p-4 rounded-2xl mb-4 max-w-[80%]">
          Cześć! Jestem asystentem inicjatywy Polska Loteria Sejmowa. Jak mogę Ci pomóc? Mogę wyjaśnić mechanizm losowania, pomóc z propozycją zmiany w ordynacji lub odpowiedzieć na pytania o rejestr kandydatów.
        </div>
      </div>
      
      <div class="p-4 border-t flex gap-3">
        <input id="ai-input" type="text" placeholder="Zadaj pytanie..." class="flex-1 border rounded-2xl px-4 py-3 text-sm" onkeypress="if(event.key === 'Enter') sendAIMessage()">
        <button onclick="sendAIMessage()" class="btn px-6">Wyślij</button>
      </div>
    </div>
  </div>

  <script>
    function showAIAssistant() {
      document.getElementById('ai-modal').classList.remove('hidden');
      document.getElementById('ai-modal').classList.add('flex');
    }
    
    function hideAIAssistant() {
      document.getElementById('ai-modal').classList.remove('flex');
      document.getElementById('ai-modal').classList.add('hidden');
    }

    function sendAIMessage() {
      const input = document.getElementById('ai-input');
      const chat = document.getElementById('ai-chat');
      if (!input.value.trim()) return;

      // User message
      const userMsg = document.createElement('div');
      userMsg.className = 'bg-[#c00000] text-white p-4 rounded-2xl mb-4 ml-auto max-w-[80%]';
      userMsg.textContent = input.value;
      chat.appendChild(userMsg);

      const question = input.value.toLowerCase();
      input.value = '';

      // Simple AI responses
      setTimeout(() => {
        const botMsg = document.createElement('div');
        botMsg.className = 'bg-gray-100 p-4 rounded-2xl mb-4 max-w-[80%]';
        
        if (question.includes('losowanie') || question.includes('jak')) {
          botMsg.textContent = 'Losowanie odbywa się na żywo w każdym okręgu. Kandydaci losowani są spośród zgłoszonych mieszkańców. Po wygraniu losowania pełnisz funkcję posła tylko do momentu wprowadzenia zmian w ordynacji.';
        } else if (question.includes('kandydat') || question.includes('rejestr')) {
          botMsg.textContent = 'W rejestrze kandydatów możesz zobaczyć profile osób z Twojego okręgu, ocenić je gwiazdkami i przeczytać ich portfolio. Pełna rejestracja i głosowanie dostępne po zalogowaniu.';
        } else if (question.includes('podpis')) {
          botMsg.textContent = 'Aktualnie zebraliśmy ponad 1,2 mln podpisów. Możesz podpisać petycję online lub pobrać formularz papierowy i zebrać podpisy wśród znajomych.';
        } else {
          botMsg.textContent = 'Dziękuję za pytanie! Wkrótce dodamy więcej funkcji AI. W międzyczasie polecam zapoznać się z sekcją "Jak chcemy to osiągnąć" lub skontaktować się z nami mailowo.';
        }
        chat.appendChild(botMsg);
        chat.scrollTop = chat.scrollHeight;
      }, 800);
    }

    function rateCandidate(index) {
      const stars = prompt('Oceń kandydata od 1 do 5 gwiazdek:');
      if (stars) {
        alert('Dziękujemy! Twoja ocena (' + stars + '★) została zapisana. W pełnej wersji będzie widoczna natychmiast.');
      }
    }

    function submitLotteryForm(e) {
      e.preventDefault();
      alert('Dziękujemy! Twoje zgłoszenie do puli losowania zostało przyjęte. Otrzymasz e-mail z potwierdzeniem i informacjami o losowaniu na żywo.');
      e.target.reset();
    }

    function submitProposal(e) {
      e.preventDefault();
      const input = e.target.querySelector('input');
      if (input.value.trim()) {
        alert('Twoja propozycja została wysłana do moderacji. Po zatwierdzeniu przez społeczność pojawi się na liście.');
        input.value = '';
      }
    }

    // Simple confetti on load for hero (optional fun)
    console.log('%c[PLS2027] Strona załadowana pomyślnie w Astro + Tailwind', 'color:#c00000');
  </script>
</Layout>