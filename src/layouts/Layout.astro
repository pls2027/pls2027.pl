---
interface Props {
  title: string;
  description?: string;
}

const { title, description = "Polska Loteria Sejmowa 2027 - Inicjatywa na rzecz prawdziwej demokracji" } = Astro.props;
---

<!doctype html>
<html lang="pl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="stylesheet" href="/src/styles/global.css" />
</head>
<body class="bg-gray-50 text-gray-900">
  <slot />
</body>
</html>